# ==========================================
# 🍎 iOS / Xcode / Swift Package Manager
# ==========================================
# Build artifacts
**/iosApp/DerivedData/
**/iosApp/build/

# User-specific settings (Crucial to ignore!)
**/iosApp/*.xcodeproj/xcuserdata/
**/iosApp/*.xcworkspace/xcuserdata/
**/iosApp/*.xcodeproj/project.xcworkspace/xcuserdata/
**/iosApp/.txt

# Xcode internal & state files
.mtl
.dtors
*.mode1v3
*.mode2v3
*.storyboardc
*.nib
*.xccheckout
*.moved-aside

# CocoaPods (Ignore if you let Gradle handle it, keep if you manage pods manually)
# **/iosApp/Pods/

