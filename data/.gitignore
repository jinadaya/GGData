.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries/
.idea/shelf/
.idea/nav/
.idea/caches/

# VS Code & Fleet
.vscode/
.fleet/

